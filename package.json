{
  "name": "the-pizza-wave-stage-1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "demo": "vite --mode pitch",
    "pitch": "vite --mode pitch",
    "build:pitch": "npm run typecheck && vite build --mode pitch",
    "build:vercel": "npm run build:pitch",
    "preview:pitch": "vite preview --port 4174",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src",
    "backend:install": "py -3.12 -m venv backend/.venv && backend\\.venv\\Scripts\\python -m pip install -e \"backend[dev]\"",
    "backend:dev": "backend\\.venv\\Scripts\\python -m uvicorn app.main:app --reload --reload-dir backend --app-dir backend --port 8000",
    "backend:test": "backend\\.venv\\Scripts\\python -m pytest backend/tests",
    "backend:lint": "backend\\.venv\\Scripts\\python -m ruff check backend",
    "backend:typecheck": "backend\\.venv\\Scripts\\python -m mypy backend/app",
    "check": "npm run lint && npm run typecheck && npm run test && npm run backend:lint && npm run backend:typecheck && npm run backend:test"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/phudu": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@gsap/react": "^2.1.2",
    "@tanstack/react-query": "5.102.8",
    "axios": "1.20.0",
    "dexie": "4.4.5",
    "framer-motion": "13.2.0",
    "gsap": "^3.15.0",
    "lucide-react": "1.42.0",
    "msw": "2.15.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.87.0",
    "react-router-dom": "7.18.3",
    "vite-plugin-pwa": "1.3.0",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "fake-indexeddb": "6.2.4",
    "jsdom": "30.0.1",
    "oxlint": "1.76.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
